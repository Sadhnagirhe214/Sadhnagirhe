#include <stdio.h>

#define SIZE 10

int queue[SIZE];
int front = -1, rear = -1;

void send(int data)
{
    if (rear == SIZE - 1)
    {
        printf("Queue is full\n");
    }
    else
    {
        if (front == -1)
            front = 0;

        rear++;
        queue[rear] = data;
        printf("Data sent: %d\n", data);
    }
}

void receive()
{
    if (front == -1 || front > rear)
    {
        printf("No data to receive\n");
    }
    else
    {
        printf("Data received: %d\n", queue[front]);
        front++;
    }
}

int main()
{
    int choice, data;

    while (1)
    {
        printf("\n1. Send Data");
        printf("\n2. Receive Data");
        printf("\n3. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        if (choice == 1)
        {
            printf("Enter data: ");
            scanf("%d", &data);
            send(data);
        }
        else if (choice == 2)
        {
            receive();
        }
        else if (choice == 3)
        {
            break;
        }
        else
        {
            printf("Invalid choice\n");
        }
    }

    return 0;
}
