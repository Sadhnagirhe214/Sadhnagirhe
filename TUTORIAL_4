
#include <stdio.h>

struct Student
{
    int rollno;
    char name[50];
    float marks;
};

int main()
{
    struct Student s[100], temp;
    int n = 0, choice, i, j, key, found;

    do
    {
        printf("\n====== DATABASE MANAGEMENT MENU ======\n");
        printf("1. Create Database\n");
        printf("2. Display Database\n");
        printf("3. Modify Record\n");
        printf("4. Search Record\n");
        printf("5. Sort Database\n");
        printf("6. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter number of students: ");
                scanf("%d", &n);

                if(n <= 0 || n > 100)
                {
                    printf("Invalid number of records!\n");
                    n = 0;
                    break;
                }

                for(i = 0; i < n; i++)
                {
                    printf("\nEnter details of student %d:\n", i + 1);

                    printf("Enter Roll Number: ");
                    scanf("%d", &s[i].rollno);

                    printf("Enter Name: ");
                    scanf(" %49[^\n]", s[i].name);

                    printf("Enter Marks: ");
                    scanf("%f", &s[i].marks);
                }

                printf("\nDatabase created successfully!\n");
                break;

            case 2:
                if(n == 0)
                {
                    printf("Database is empty!\n");
                    break;
                }

                printf("\n----- STUDENT DATABASE -----\n");
                printf("Roll No\tName\t\tMarks\n");

                for(i = 0; i < n; i++)
                {
                    printf("%d\t%-15s\t%.2f\n",
                    s[i].rollno, s[i].name, s[i].marks);
                }
                break;

            case 3:
                if(n == 0)
                {
                    printf("Database is empty!\n");
                    break;
                }

                printf("Enter Roll Number to modify: ");
                scanf("%d", &key);

                found = 0;

                for(i = 0; i < n; i++)
                {
                    if(s[i].rollno == key)
                    {
                        printf("Enter new Name: ");
                        scanf(" %49[^\n]", s[i].name);

                        printf("Enter new Marks: ");
                        scanf("%f", &s[i].marks);

                        printf("Record modified successfully!\n");
                        found = 1;
                        break;
                    }
                }

                if(found == 0)
                    printf("Record not found!\n");

                break;

            case 4:
                if(n == 0)
                {
                    printf("Database is empty!\n");
                    break;
                }

                printf("Enter Roll Number to search: ");
                scanf("%d", &key);

                found = 0;

                for(i = 0; i < n; i++)
                {
                    if(s[i].rollno == key)
                    {
                        printf("\nRecord Found!\n");
                        printf("Roll Number: %d\n", s[i].rollno);
                        printf("Name: %s\n", s[i].name);
                        printf("Marks: %.2f\n", s[i].marks);

                        found = 1;
                        break;
                    }
                }

                if(found == 0)
                    printf("Record not found!\n");

                break;

            case 5:
                if(n == 0)
                {
                    printf("Database is empty!\n");
                    break;
                }

                // Sorting according to Roll Number
                for(i = 0; i < n - 1; i++)
                {
                    for(j = 0; j < n - i - 1; j++)
                    {
                        if(s[j].rollno > s[j + 1].rollno)
                        {
                            temp = s[j];
                            s[j] = s[j + 1];
                            s[j + 1] = temp;
                        }
                    }
                }

                printf("Database sorted successfully!\n");
                break;

            case 6:
                printf("Exiting program...\n");
                break;

            default:
                printf("Invalid choice! Please try again.\n");
        }

    } while(choice != 6);

    return 0;
}
